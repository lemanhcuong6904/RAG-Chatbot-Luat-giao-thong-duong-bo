OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4o-mini
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-4o-mini
RAG_OPENAI_TEMPERATURE=0.7
RAG_OPENAI_MAX_TOKENS=1200
RAG_PRERAG_PROVIDER=openai
RAG_PRERAG_MODEL=gpt-4o-mini
RAG_PRERAG_TEMPERATURE=0.1
RAG_PRERAG_MAX_TOKENS=900
RAG_QUERY_ROUTER_PROVIDER=openai
RAG_QUERY_ROUTER_MODEL=gpt-4o-mini
RAG_QUERY_ROUTER_TEMPERATURE=0
RAG_QUERY_ROUTER_MAX_TOKENS=700
RAG_SANCTION_LLM_PROVIDER=openai
RAG_SANCTION_LLM_MODEL=gpt-4o-mini
RAG_SANCTION_LLM_TEMPERATURE=0.2
RAG_SANCTION_LLM_MAX_TOKENS=900
# Local OpenAI-compatible LLM, for example Qwen3.5 4B Q4_K_M served by llama.cpp.
# Set providers to qwen_local to use this endpoint:
# RAG_LLM_PROVIDER=qwen_local
# RAG_PRERAG_PROVIDER=qwen_local
# RAG_QUERY_ROUTER_PROVIDER=qwen_local
# RAG_SANCTION_LLM_PROVIDER=qwen_local
RAG_LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
RAG_LOCAL_LLM_API_KEY=local
RAG_LOCAL_LLM_MODEL=qwen3.5-4b-q4_k_m
RAG_ROOT_DIR=.
RAG_MARKDOWN_DIR=data/markdown
RAG_INDEX_DIR=data/index
RAG_DENSE_ENABLED=true
RAG_EMBEDDING_PRESET=bge_m3
# Options:
# - bge_m3: BAAI/bge-m3
# - qwen3_0_6b: Qwen/Qwen3-Embedding-0.6B
# Leave blank to use the selected preset model; set only for a custom SentenceTransformer model.
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_VECTOR_SIZE=1024
RAG_EMBEDDING_LOCAL_FILES_ONLY=false
# Leave blank to use preset instructions.
RAG_EMBEDDING_QUERY_INSTRUCTION=
RAG_EMBEDDING_DOCUMENT_INSTRUCTION=
RAG_EMBEDDING_TRUST_REMOTE_CODE=false
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_TOP_N=40
RAG_RERANKER_LOCAL_FILES_ONLY=false
QDRANT_COLLECTION=traffic_law_chunks
QDRANT_PATH=data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_DEVICE=cpu
RAG_RERANKER_TOP_N=40
RAG_RERANKER_LOCAL_FILES_ONLY=true
RAG_STRUCTURED_LOOKUP_ENABLED=true
RAG_STRUCTURED_FACT_ENABLED=true
RAG_STRUCTURED_FACT_USE_WITH_LLM=false
RAG_STRUCTURED_TABLE_ENABLED=true
RAG_STRUCTURED_TABLE_USE_WITH_LLM=false
RAG_STRUCTURED_SANCTION_ENABLED=true
RAG_STRUCTURED_SANCTION_REQUIRE_LLM_PLAN=true
RAG_DETERMINISTIC_ANSWER_USE_WITH_LLM=false
SANCTION_DB_PATH=structured_sanction_layer/structured_sanction_layer/sanctions.sqlite
